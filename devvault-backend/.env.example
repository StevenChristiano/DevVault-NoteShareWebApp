APP_PORT=8080
APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_postgres_database_name
DB_SSLMODE=disable

# Ganti dengan string acak panjang di komputer kamu sendiri (bukan
# nilai contoh ini) — ini kunci rahasia buat menandatangani JWT.
# JANGAN pernah pakai nilai contoh ini di production.
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
JWT_EXPIRY_HOUR=24